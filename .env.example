# Supabase (to be added when backend work starts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter API key for AI autofill (feature/real-submission-prototype branch).
# Get one free at https://openrouter.ai/keys — server-only, never NEXT_PUBLIC_.
# Switched from Gemini because its free tier kept returning 503 "overloaded"
# errors, including on paid tiers (503 is shared capacity, not account quota).
OPENROUTER_API_KEY=
# Optional: override the default model (see route.ts for the free fallback list).
OPENROUTER_MODEL=
